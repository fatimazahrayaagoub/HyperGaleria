 <Window x:Class="HyperGaleria.Ventanas.NaveWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperGaleria"
        Height="600"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2">

    <Window.Resources>
        <Style x:Key="EstiloBotonNavegacion"
               TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="PanelPrincipal">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Background="#263449">

            <TextBlock Text="HyperGaleria"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="15"
                       VerticalAlignment="Center"/>

            <Button Content="Cambiar tema"
                    Style="{StaticResource EstiloBotonNavegacion}"
                    Click="CambiarTema_Click"/>

        </DockPanel>

        <Grid Grid.Row="1" Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">

                <Button Content="Seleccionar carpeta"
                        Style="{StaticResource EstiloBotonNavegacion}"
                        Click="SeleccionarCarpeta_Click"/>

                <Button x:Name="btnSubir"
                        Content="Subir carpeta"
                        Style="{StaticResource EstiloBotonNavegacion}"
                        Click="SubirCarpeta_Click"/>

                <TextBlock x:Name="txtRuta"
                           Text="Ninguna carpeta seleccionada"
                           Foreground="{DynamicResource AppForeground}"
                           VerticalAlignment="Center"
                           Margin="10"/>

            </StackPanel>

            <ListView x:Name="listaArchivos"
                      Grid.Row="1"
                      SelectionChanged="ListaArchivos_SelectionChanged">

                <ListView.View>
                    <GridView>

                        <GridViewColumn Header="Nombre"
                                        DisplayMemberBinding="{Binding Nombre}"
                                        Width="250"/>

                        <GridViewColumn Header="Extensión"
                                        DisplayMemberBinding="{Binding Extension}"
                                        Width="100"/>

                        <GridViewColumn Header="Tipo"
                                        DisplayMemberBinding="{Binding Tipo}"
                                        Width="150"/>

                        <GridViewColumn Header="Tamaño (bytes)"
                                        DisplayMemberBinding="{Binding Tamano}"
                                        Width="150"/>

                    </GridView>
                </ListView.View>

            </ListView>

        </Grid>
    </Grid>
</Window>
