<Window x:Class="HyperGaleria.Ventanas.DetailWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HyperGaleria.Ventanas"
        xmlns:md="http://schemas.lepo.co/wpfui/2022/xaml/markdown"
        mc:Ignorable="d"
        Title="DetailWin" Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/ImageStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/MediaStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/TextStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/MarkdownStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
                <Setter Property="BorderBrush" Value="#FFE67E22"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="{Binding Nombre}" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>

        <Grid x:Name="ContenedorPrincipal" Grid.Row="1">
            <ScrollViewer x:Name="ScrollMd" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <md:MarkdownViewer x:Name="MdViewer" Style="{StaticResource MarkdownViewerStyle}"/>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <StackPanel x:Name="PanelControles" DockPanel.Dock="Left" Orientation="Horizontal"/>
            <Button Content="Cancelar" IsCancel="True" DockPanel.Dock="Right" Click="BtnCancelar_Click"/>
        </DockPanel>
    </Grid>
</Window>
